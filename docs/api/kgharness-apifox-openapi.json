      "get": {
        "tags": [
          "RAG 系统"
        ],
        "summary": "RAG 健康检查",
        "operationId": "rag_health_api_v1_rag_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Rag Health Api V1 Rag Health Get"
                }
              }
            }
          }
        },
        "description": "检查 RAG 数据库连接。"
      }
    },

            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tenant-Id"
            },
            "description": "租户 UUID；不传时使用默认测试租户。生产环境应显式传入。",

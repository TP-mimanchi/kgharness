                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tenant-Id"
            },
            "description": "租户 UUID；不传时使用默认测试租户。生产环境应显式传入。",
            "example": "00000000-0000-0000-0000-000000000001"

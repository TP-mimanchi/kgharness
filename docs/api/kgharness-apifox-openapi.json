              "example": {
                "query": "结合知识库证据，分析企业级 RAG 的实施风险并给出建议。",
                "thread_id": "7b1f3b92-9d41-4e76-a6bf-a27877c75f09"
              }
            }
          },
          "required": true
        },
        "responses": {

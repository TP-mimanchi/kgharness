# Alibaba Cloud Model Studio (DashScope). Legacy OPENAI_* names remain supported.
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=replace-me
#DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#DASHSCOPE_API_KEY=replace-me
LLM_QWEN_MAX=deepseek-v4-flash
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-v3
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_BATCH_SIZE=10
RAG_RERANK_MODEL=qwen3-rerank
# Optional override; by default this is derived from DASHSCOPE_BASE_URL.
# DASHSCOPE_RERANK_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
RAG_RERANK_CANDIDATE_K=20
RAG_RERANK_FAILURE_MODE=fallback

# Optional public web search
TAVILY_API_KEY=replace-me

# PostgreSQL / Docker Compose
POSTGRES_DB=kgharness
POSTGRES_USER=kgharness
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
RAG_DATABASE_URL=postgresql://kgharness:${POSTGRES_PASSWORD}@localhost:5432/kgharness
BUSINESS_DATABASE_URL=postgresql://kgharness:${POSTGRES_PASSWORD}@localhost:5432/kgharness
RAG_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=80
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis / distributed Agent execution. Docker Compose injects an internal
# redis:// URL into containers; REDIS_URL below is for local development.
RUN_EXECUTION_MODE=distributed
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0
REDIS_KEY_PREFIX=kgharness
AGENT_WORKER_GROUP=kgharness-agent-workers
AGENT_WORKER_CONCURRENCY=2
AGENT_WORKER_CLAIM_IDLE_MS=120000
AGENT_WORKER_HEARTBEAT_SECONDS=10
AGENT_CANCEL_POLL_SECONDS=0.5
AGENT_WORKER_REGISTRY_TTL_SECONDS=45
AGENT_WORKER_SHUTDOWN_GRACE_SECONDS=30
AGENT_WORKER_HEALTH_FILE=/tmp/kgharness-agent-worker.ready
AGENT_RUN_MAX_ATTEMPTS=3
AGENT_RUN_RETRY_BASE_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=30
RUN_EVENT_STREAM_MAX_LENGTH=2000
RUN_EVENT_TTL_SECONDS=86400
RUN_EVENT_PUBLISH_INTERVAL_MS=15
RUN_EVENT_PUBLISH_BATCH_SIZE=64
RUN_STATE_TTL_SECONDS=604800

# PostgreSQL pools validate every checked-out connection and rotate long-lived
# connections before common load-balancer/NAT idle limits.
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_POOL_TIMEOUT_SECONDS=15
POSTGRES_POOL_MAX_LIFETIME_SECONDS=1800
POSTGRES_POOL_MAX_IDLE_SECONDS=300
POSTGRES_POOL_RECONNECT_TIMEOUT_SECONDS=30
CHECKPOINT_POOL_MIN_SIZE=1
CHECKPOINT_POOL_MAX_SIZE=4

# RAG runtime
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_DENSE_TOP_K=30
RAG_SPARSE_TOP_K=30
RAG_FINAL_TOP_K=8
RAG_MAX_UPLOAD_BYTES=104857600

# Transitional source database; only needed for one-time migration
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=deepsearch_db

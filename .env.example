# Alibaba Cloud Model Studio (DashScope). Legacy OPENAI_* names remain supported.
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=replace-me
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=replace-me
LLM_QWEN_MAX=qwen-max
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_BATCH_SIZE=10
RAG_RERANK_MODEL=qwen3-rerank
# Optional override; by default this is derived from DASHSCOPE_BASE_URL.
# DASHSCOPE_RERANK_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
RAG_RERANK_CANDIDATE_K=20
RAG_RERANK_FAILURE_MODE=fallback

# Optional public web search
TAVILY_API_KEY=replace-me

# PostgreSQL / Docker Compose
POSTGRES_DB=kgharness
POSTGRES_USER=kgharness
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_PORT=80
CORS_ALLOWED_ORIGINS=http://localhost

# RAG runtime
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_DENSE_TOP_K=30
RAG_SPARSE_TOP_K=30
RAG_FINAL_TOP_K=8
RAG_MAX_UPLOAD_BYTES=104857600

# Transitional source database; only needed for one-time migration
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=deepsearch_db


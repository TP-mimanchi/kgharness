# Alibaba Cloud Model Studio (DashScope). Legacy OPENAI_* names remain supported.
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=replace-me
#DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#DASHSCOPE_API_KEY=replace-me
LLM_QWEN_MAX=deepseek-v4-flash
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-v3
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_BATCH_SIZE=10
RAG_RERANK_MODEL=qwen3-rerank
# Optional override; by default this is derived from DASHSCOPE_BASE_URL.
# DASHSCOPE_RERANK_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
RAG_RERANK_CANDIDATE_K=20
RAG_RERANK_FAILURE_MODE=fallback

# Optional public web search
TAVILY_API_KEY=replace-me

# PostgreSQL / Docker Compose
POSTGRES_DB=kgharness
POSTGRES_USER=kgharness
POSTGRES_PASSWORD=replace-with-a-long-alphanumeric-password
REDIS_PASSWORD=replace-with-a-long-alphanumeric-password
APP_PORT=80
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Celery / Redis. Docker Compose injects service URLs; these defaults are for local runs.
REDIS_URL=redis://:replace-with-a-long-alphanumeric-password@localhost:6379
CELERY_BROKER_URL=redis://:replace-with-a-long-alphanumeric-password@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:replace-with-a-long-alphanumeric-password@localhost:6379/1
EVENT_REDIS_URL=redis://:replace-with-a-long-alphanumeric-password@localhost:6379/2
CELERY_AGENT_QUEUE=agent
CELERY_INGESTION_QUEUE=ingestion
CELERY_RESULT_EXPIRES_SECONDS=86400
EVENT_STREAM_TTL_SECONDS=86400
EVENT_STREAM_MAXLEN=1000
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=3300
CELERY_TASK_TIME_LIMIT_SECONDS=3600
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
DEPENDENCY_HEALTH_TIMEOUT_SECONDS=5

# RAG runtime
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_DENSE_TOP_K=30
RAG_SPARSE_TOP_K=30
RAG_FINAL_TOP_K=8
RAG_MAX_UPLOAD_BYTES=104857600

# Transitional source database; only needed for one-time migration
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=deepsearch_db
